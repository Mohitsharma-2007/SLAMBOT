# SLAM Bot backend configuration — copy to .env and edit, or set these in your
# shell before launching uvicorn. Every value here has a working default except
# OPENROUTER_API_KEY.

# --- server ------------------------------------------------------------------
SLAM_HOST=0.0.0.0
SLAM_PORT=8000

# Comma-separated origins allowed for CORS during development (the Vite dev
# server). Not needed in production, where the backend serves webapp/dist itself.
SLAM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- robot link --------------------------------------------------------------
# How often the backend sends cmd_vel/ping to the Arduino. Must stay well inside
# the firmware's 2 s watchdog (§11.2) — do not drop this below ~1 Hz.
SLAM_HEARTBEAT_HZ=4.0

# A manual drive command expires this fast unless the browser refreshes it, so a
# frozen tab or a closed laptop cannot leave the robot driving.
SLAM_MANUAL_TTL_MS=500

# How long a device may go quiet before the UI flags it as stale.
SLAM_DEVICE_STALE_MS=3000

# --- frontend push rates -----------------------------------------------------
SLAM_STATUS_HZ=5.0
SLAM_SCAN_HZ=8.0
SLAM_MAP_HZ=1.0

# --- ROS2 --------------------------------------------------------------------
# Set to 0 to run without ROS2. Dashboard, polar scan, logs, tuning and flashing
# all work; only the occupancy grid and Nav2 goals need it.
SLAM_ENABLE_ROS=1

# --- arduino-cli (Flash Center, §6.4) ---------------------------------------
# Full path if arduino-cli is not on PATH.
SLAM_ARDUINO_CLI=arduino-cli
SLAM_ARDUINO_FQBN=arduino:renesas_uno:unor4wifi
SLAM_NODEMCU_FQBN=esp8266:esp8266:nodemcuv2
SLAM_FLASH_TIMEOUT_S=300

# Override only if you moved the firmware directories.
# SLAM_ARDUINO_SKETCH=/path/to/firmware/arduino_uno_r4
# SLAM_NODEMCU_SKETCH=/path/to/firmware/nodemcu_lidar
# SLAM_BUILD_DIR=/path/to/build

# --- OpenRouter (AI Assistant, §9) ------------------------------------------
# Required for the AI Assistant page only. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Ordered fallback candidates. §9 forbids hardcoding a model: the backend queries
# /models at startup, keeps only entries priced at zero, and picks the first of
# these that is actually free and available. Free-tier availability rotates, so
# expect to refresh this list occasionally.
OPENROUTER_MODELS=deepseek/deepseek-chat-v3.1:free,meta-llama/llama-3.3-70b-instruct:free,qwen/qwen-2.5-72b-instruct:free

OPENROUTER_TIMEOUT_S=90

# Set to 0 to skip the startup /models probe (offline development).
SLAM_RESOLVE_MODEL=1

# --- static frontend ---------------------------------------------------------
SLAM_SERVE_WEBAPP=1
# SLAM_WEBAPP_DIST=/path/to/webapp/dist
