{
  "name": "slam-bot-desktop",
  "version": "1.0.0",
  "description": "All-in-One Desktop Application Wrapper for SLAM Bot",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder --win"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.slambot.desktop",
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "dist"
    }
  }
}
