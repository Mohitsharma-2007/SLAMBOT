// Copy this file to secrets.h and fill in your phone hotspot details.
// secrets.h is gitignored — never commit real credentials.
//
// The Arduino Uno R4 WiFi radio is 2.4 GHz only. On most phones you must
// set the hotspot band to 2.4 GHz explicitly; the default is often 5 GHz
// or "auto", and the board simply will not see a 5 GHz network.
//   Android: Hotspot settings -> AP Band -> 2.4 GHz
//   iPhone:  Personal Hotspot -> Maximise Compatibility -> ON

#define WIFI_SSID  "your-phone-hotspot"
#define WIFI_PASS  "your-hotspot-password"
