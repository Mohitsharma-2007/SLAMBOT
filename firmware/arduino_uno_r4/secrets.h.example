// ---------------------------------------------------------------------------
// SLAM Bot — Arduino Uno R4 WiFi credentials / backend location
//
// Copy this file to `secrets.h` in the same directory and fill in your values.
// `secrets.h` is gitignored so credentials never get committed.
// ---------------------------------------------------------------------------
#pragma once

#define WIFI_SSID     "YOUR_WIFI_SSID"
#define WIFI_PASS     "YOUR_WIFI_PASSWORD"

// IP (or hostname) and port of the machine running the FastAPI backend.
// Must be reachable from the robot's WiFi network. Use the LAN IP, not
// "localhost" — localhost means "the Arduino itself" from here.
#define BACKEND_HOST  "192.168.1.50"
#define BACKEND_PORT  8000
#define BACKEND_PATH  "/ws/motion"
