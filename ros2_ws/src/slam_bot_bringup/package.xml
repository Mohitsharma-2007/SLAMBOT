<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>slam_bot_bringup</name>
  <version>1.0.0</version>
  <description>
    Launch files and parameters that bring up the SLAM Bot's ROS2 side:
    slam_toolbox (async mapping) plus the Nav2 stack from slam_bot_nav.
  </description>
  <maintainer email="you@example.com">SLAM Bot</maintainer>
  <license>MIT</license>

  <exec_depend>slam_bot_bridge</exec_depend>
  <exec_depend>slam_bot_nav</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
