<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>slam_bot_nav</name>
  <version>1.0.0</version>
  <description>
    Nav2 configuration for the SLAM Bot: costmaps, SmacPlanner2D (A*) global
    planner and the DWB local controller, sized for a ~150 mm wheelbase robot
    running at 300 mm/s. See §8 of the spec for the algorithm choices.
  </description>
  <maintainer email="you@example.com">SLAM Bot</maintainer>
  <license>MIT</license>

  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>nav2_smac_planner</exec_depend>
  <exec_depend>dwb_core</exec_depend>
  <exec_depend>nav2_dwb_controller</exec_depend>
  <exec_depend>nav2_costmap_2d</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>
  <exec_depend>nav2_collision_monitor</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
